{
  "name": "pi-extensions-shuyuan",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "统一管理 Pi 错误恢复与受管后台 Bash 扩展",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/librola/pi-extensions-shuyuan.git"
  },
  "homepage": "https://github.com/librola/pi-extensions-shuyuan#readme",
  "bugs": {
    "url": "https://github.com/librola/pi-extensions-shuyuan/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "pi-error-retry",
    "pi-background-bash"
  ],
  "scripts": {
    "test": "npm test --workspaces && npm run test:package",
    "test:package": "node --test tests/*.test.mjs",
    "check": "npm run check --workspaces && npm test --workspace=pi-error-retry && npm run test:package",
    "test:web": "npm run test:web --workspace=pi-background-bash"
  },
  "pi": {
    "extensions": [
      "./pi-error-retry/index.ts",
      "./pi-background-bash/src/index.ts"
    ]
  },
  "piWeb": {
    "apiVersion": 1,
    "lifecycle": "session",
    "id": "pi-background-bash",
    "label": "后台 Bash 任务",
    "entry": "pi-background-bash/web/browser.js",
    "assets": [
      "pi-background-bash/web/browser.js",
      "pi-background-bash/web/dropdown.js",
      "pi-background-bash/web/counter.js",
      "pi-background-bash/web/parse.js",
      "pi-background-bash/web/style.css"
    ],
    "bridge": {
      "entry": "pi-background-bash/web/bridge.mjs",
      "actions": [
        {
          "name": "count",
          "kind": "query",
          "session": "active",
          "input": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "list",
          "kind": "query",
          "session": "active",
          "input": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "status",
          "kind": "query",
          "session": "active",
          "input": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "name": "output",
          "kind": "query",
          "session": "active",
          "input": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 40
              },
              "tail": {
                "type": "number"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "name": "stop",
          "kind": "mutation",
          "session": "active",
          "input": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "name": "background",
          "kind": "mutation",
          "session": "active",
          "input": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        }
      ],
      "permissions": {
        "events": [
          {
            "package": "@librola33/pi-background-bash",
            "version": ">=0.2.0 <0.3.0",
            "request": "pi-background-bash:rpc:v1:request",
            "replyPrefix": "pi-background-bash:rpc:v1:reply:",
            "methods": [
              "ping",
              "list",
              "status",
              "output",
              "stop",
              "background"
            ],
            "queryMethods": [
              "ping",
              "list",
              "status",
              "output"
            ]
          }
        ]
      }
    }
  },
  "files": [
    "CHANGELOG.md",
    "pi-error-retry/CHANGELOG.md",
    "pi-error-retry/index.ts",
    "pi-error-retry/src",
    "pi-error-retry/examples",
    "pi-error-retry/package.json",
    "pi-error-retry/README.md",
    "pi-background-bash/CHANGELOG.md",
    "pi-background-bash/src",
    "pi-background-bash/web",
    "pi-background-bash/package.json",
    "pi-background-bash/README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
